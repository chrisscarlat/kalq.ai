{
    "installCommand": "sh tools/vercel-install.sh",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow"
                }
            ]
        }
    ],
    "functions": {
        "api/*.js": {
            "includeFiles": "{site.config.json,{index,platform,company,impressum,datenschutz,gate}.html,js/strings.js,js/strings-public.js,assets/logo.svg}"
        }
    }
}
